{"name":"given events and a view, no command: folding them gives that state","given":[{"kind":"TurnStarted","data":{"game":"cat","turn":1,"agent":"claude"}},{"kind":"TurnStarted","data":{"game":"dog","turn":2,"agent":"codex"}}],"then":{"view":{"Desk":{"running":[{"game":"cat","turn":1},{"game":"dog","turn":2}],"lastTurn":2}}}}
{"name":"an accepted command with no events listed only has to be accepted","given":[],"when":{"command":"PickAgent","data":{"game":"cat","agent":"codex"}},"then":{}}

{"name":"the events listed are exact: kinds, data and order","given":[],"when":{"command":"SendMessage","data":{"game":"cat","text":"hello"}},"then":{"events":[{"kind":"MessageSent","data":{"game":"cat","text":"hello"}},{"kind":"TurnStarted","data":{"game":"cat","turn":1,"agent":"claude"}}]}}
{"name":"object key order does not matter","given":[],"when":{"data":{"text":"hello","game":"cat"},"command":"SendMessage"},"then":{"events":[{"data":{"text":"hello","game":"cat"},"kind":"MessageSent"},{"data":{"agent":"claude","turn":1,"game":"cat"},"kind":"TurnStarted"}]}}
{"name":"a refusal is checked by its code only","given":[{"kind":"TurnStarted","data":{"game":"cat","turn":1,"agent":"claude"}}],"when":{"command":"SendMessage","data":{"game":"cat","text":"again"}},"then":{"refused":"busy"}}
{"name":"an unknown command is refused with the code unknownCommand","given":[],"when":{"command":"NoSuchCommand","data":{}},"then":{"refused":"unknownCommand"}}
{"name":"the produced events are folded into the views after the command","given":[],"when":{"command":"SendMessage","data":{"game":"cat","text":"hello"}},"then":{"events":[{"kind":"MessageSent","data":{"game":"cat","text":"hello"}},{"kind":"TurnStarted","data":{"game":"cat","turn":1,"agent":"claude"}}],"view":{"Chat":{"lines":[{"game":"cat","who":"you","text":"hello"}]},"Desk":{"running":[{"game":"cat","turn":1}],"lastTurn":1}}}}
{"name":"a refusal changes no view","given":[{"kind":"TurnStarted","data":{"game":"cat","turn":1,"agent":"claude"}}],"when":{"command":"SendMessage","data":{"game":"cat","text":"again"}},"then":{"refused":"busy","view":{"Chat":{"lines":[]},"Desk":{"running":[{"game":"cat","turn":1}],"lastTurn":1}}}}
{"name":"only the fields listed are compared","given":[{"kind":"StepStarted","data":{"game":"cat","step":1,"kind":"check"}}],"then":{"view":{"Desk":{"stepKind":"check"}}}}
{"name":"a view that starts empty has fields zero, empty or false","given":[],"then":{"view":{"Desk":{"running":[],"lastTurn":0,"stepRunning":false,"stepId":0,"stepKind":"","stepGame":"","lastStepCode":0,"picks":[]},"Chat":{"lines":[]}}}}
{"name":"a list in a view is compared whole and in order","given":[{"kind":"MessageSent","data":{"game":"cat","text":"first"}},{"kind":"Said","data":{"game":"cat","turn":1,"text":"second"}},{"kind":"MessageSent","data":{"game":"cat","text":"third"}}],"then":{"view":{"Chat":{"lines":[{"game":"cat","who":"you","text":"first"},{"game":"cat","who":"producer","text":"second"},{"game":"cat","who":"you","text":"third"}]}}}}
{"name":"an event a view does not consume leaves it unchanged","given":[{"kind":"ConversationCleared","data":{"game":"cat"}}],"then":{"view":{"Desk":{"running":[],"lastTurn":0}}}}
{"name":"now is handed to the decision and may be left out","given":[],"now":1700000000000,"when":{"command":"PickAgent","data":{"game":"cat","agent":"claude"}},"then":{"events":[{"kind":"AgentPicked","data":{"game":"cat","agent":"claude"}}]}}
